        "messages": {
          "values": [
            {
              "content": "=Jesteś asystentem obsługi klienta. Sklasyfikuj poniższe zgłoszenie.\n\nZwróć WYŁĄCZNIE poprawny JSON, bez żadnego tekstu przed ani po, w formacie:\n{\"kategoria\": \"...\", \"priorytet\": \"...\", \"streszczenie\": \"...\"}\n\nZasady:\n- kategoria: jedna z: \"reklamacja\", \"zapytanie ofertowe\", \"pytanie o zamówienie\", \"faktura\", \"inne\"\n- priorytet: jedna z: \"wysoki\", \"średni\", \"niski\"\n- streszczenie: maksymalnie 15 słów, po polsku\n\nZgłoszenie od {{ $json['Imię'] }}:\n{{ $json['Treść zgłoszenia'] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fdf97e4d-1cf2-477f-a2bc-167567404125",
      "name": "Message a model",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        224,
        0
      ],
      "credentials": {
        "anthropicApi": {
          "id": "xz4lpZkyH5kI3sgW",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.content?.[0]?.text ?? $json.text ?? $json.output ?? Object.values($json).find(v => typeof v === \"string\") ?? \"\";\nconst clean = raw.replace(/```json|```/g, \"\").trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(clean);\n} catch (e) {\n  parsed = { kategoria: \"błąd\", priorytet: \"błąd\", streszczenie: raw.slice(0, 100) };\n}\nreturn {\n  json: {\n    data: new Date().toISOString(),\n    imie: $('Support ticket classifier').item.json['Imię'],\n    tresc: $('Support ticket classifier').item.json['Treść zgłoszenia'],\n    kategoria: parsed.kategoria,\n    priorytet: parsed.priorytet,\n    streszczenie: parsed.streszczenie,\n  },\n};"
      },
